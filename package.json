{
    "name": "@pipeit/monorepo",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.6",
    "workspaces": [
        "packages/*",
        "examples/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "clean": "turbo run clean",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@solana/prettier-config-solana": "^0.0.6",
        "@types/node": "^25.9.4",
        "eslint": "^10.6.0",
        "prettier": "^3.9.4",
        "turbo": "^2.10.3",
        "typescript-eslint": "^8.62.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    },
    "engines": {
        "node": ">=22.13.0",
        "bun": ">=1.3.6"
    },
    "overrides": {
        "@solana/kit": "^7.0.0"
    },
    "trustedDependencies": [
        "bufferutil",
        "esbuild",
        "sharp",
        "unrs-resolver",
        "utf-8-validate"
    ]
}
