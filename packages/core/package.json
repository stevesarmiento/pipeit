{
    "name": "@pipeit/core",
    "version": "0.2.7",
    "description": "Type-safe transaction builder for Solana with smart defaults",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typings": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./server": {
            "types": "./dist/server/index.d.ts",
            "import": "./dist/server/index.js",
            "require": "./dist/server/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "clean": "rm -rf dist",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit",
        "test": "vitest"
    },
    "keywords": [
        "solana",
        "transaction",
        "builder",
        "simplified"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stevesarmiento/pipeit.git",
        "directory": "packages/core"
    },
    "homepage": "https://github.com/stevesarmiento/pipeit#readme",
    "bugs": {
        "url": "https://github.com/stevesarmiento/pipeit/issues"
    },
    "peerDependencies": {
        "@solana-program/compute-budget": "^0.15.0",
        "@solana/addresses": "^6.9.0",
        "@solana/codecs-strings": "^6.9.0",
        "@solana/errors": "^6.9.0",
        "@solana/functional": "^6.9.0",
        "@solana/instruction-plans": "^6.9.0",
        "@solana/instructions": "^6.9.0",
        "@solana/kit": "^6.9.0",
        "@solana/programs": "^6.9.0",
        "@solana/rpc": "^6.9.0",
        "@solana/rpc-subscriptions": "^6.9.0",
        "@solana/rpc-types": "^6.9.0",
        "@solana/signers": "^6.9.0",
        "@solana/transaction-messages": "^6.9.0",
        "@solana/transactions": "^6.9.0"
    },
    "peerDependenciesMeta": {
        "@solana/addresses": {
            "optional": false
        },
        "@solana/functional": {
            "optional": false
        },
        "@solana/instruction-plans": {
            "optional": false
        },
        "@solana/instructions": {
            "optional": false
        },
        "@solana/programs": {
            "optional": false
        },
        "@solana/rpc": {
            "optional": false
        },
        "@solana/rpc-subscriptions": {
            "optional": false
        },
        "@solana/rpc-types": {
            "optional": false
        },
        "@solana/signers": {
            "optional": false
        },
        "@solana/transaction-messages": {
            "optional": false
        },
        "@solana/transactions": {
            "optional": false
        },
        "@solana-program/compute-budget": {
            "optional": false
        }
    },
    "devDependencies": {
        "@solana-program/compute-budget": "^0.15.0",
        "@solana/addresses": "^6.10.0",
        "@solana/codecs-strings": "^6.10.0",
        "@solana/errors": "^6.10.0",
        "@solana/functional": "^6.10.0",
        "@solana/instruction-plans": "^6.10.0",
        "@solana/instructions": "^6.10.0",
        "@solana/kit": "^6.10.0",
        "@solana/programs": "^6.10.0",
        "@solana/rpc": "^6.10.0",
        "@solana/rpc-subscriptions": "^6.10.0",
        "@solana/rpc-types": "^6.10.0",
        "@solana/signers": "^6.10.0",
        "@solana/transaction-messages": "^6.10.0",
        "@solana/transactions": "^6.10.0",
        "@types/node": "^25.9.4",
        "eslint": "^10.6.0",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    }
}
