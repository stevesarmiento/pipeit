{
    "name": "@pipeit/actions",
    "version": "0.1.2",
    "description": "Composable DeFi InstructionPlan factories for Solana",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typings": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./titan": {
            "types": "./dist/titan/index.d.ts",
            "import": "./dist/titan/index.js",
            "require": "./dist/titan/index.cjs"
        },
        "./metis": {
            "types": "./dist/metis/index.d.ts",
            "import": "./dist/metis/index.js",
            "require": "./dist/metis/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "clean": "rm -rf dist",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit",
        "test": "vitest"
    },
    "keywords": [
        "solana",
        "defi",
        "swap",
        "titan",
        "jupiter",
        "metis",
        "instruction-plans",
        "transaction"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/stevesarmiento/pipeit",
        "directory": "packages/actions"
    },
    "peerDependencies": {
        "@pipeit/core": "^0.2.6",
        "@solana/addresses": "^6.9.0",
        "@solana/instruction-plans": "^6.9.0",
        "@solana/instructions": "^6.9.0",
        "@solana/kit": "^6.9.0",
        "@solana/rpc": "^6.9.0",
        "@solana/rpc-subscriptions": "^6.9.0",
        "@solana/signers": "^6.9.0",
        "@solana/transactions": "^6.9.0"
    },
    "dependencies": {
        "@msgpack/msgpack": "^3.1.3"
    },
    "devDependencies": {
        "@pipeit/core": "workspace:*",
        "@solana/addresses": "^6.9.0",
        "@solana/instruction-plans": "^6.9.0",
        "@solana/instructions": "^6.9.0",
        "@solana/kit": "^6.9.0",
        "@solana/rpc": "^6.9.0",
        "@solana/rpc-subscriptions": "^6.9.0",
        "@solana/signers": "^6.9.0",
        "@solana/transactions": "^6.9.0",
        "@types/node": "^25.9.1",
        "eslint": "^10.4.0",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.7"
    }
}
