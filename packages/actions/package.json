{
    "name": "@pipeit/actions",
    "version": "0.4.0",
    "description": "Composable DeFi InstructionPlan factories for Solana",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typings": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./titan": {
            "types": "./dist/titan/index.d.ts",
            "import": "./dist/titan/index.js",
            "require": "./dist/titan/index.cjs"
        },
        "./metis": {
            "types": "./dist/metis/index.d.ts",
            "import": "./dist/metis/index.js",
            "require": "./dist/metis/index.cjs"
        },
        "./phoenix": {
            "types": "./dist/phoenix/index.d.ts",
            "import": "./dist/phoenix/index.js",
            "require": "./dist/phoenix/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "clean": "rm -rf dist",
        "lint": "eslint src",
        "typecheck": "tsc --noEmit",
        "test": "vitest"
    },
    "keywords": [
        "solana",
        "defi",
        "swap",
        "titan",
        "jupiter",
        "metis",
        "phoenix",
        "perps",
        "perpetuals",
        "instruction-plans",
        "transaction"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/stevesarmiento/pipeit",
        "directory": "packages/actions"
    },
    "peerDependencies": {
        "@ellipsis-labs/rise": "^0.4.62",
        "@pipeit/core": "^0.3.1",
        "@solana/addresses": "^8.0.0",
        "@solana/instruction-plans": "^8.0.0",
        "@solana/instructions": "^8.0.0",
        "@solana/kit": "^8.0.0",
        "@solana/rpc": "^8.0.0",
        "@solana/rpc-subscriptions": "^8.0.0",
        "@solana/signers": "^8.0.0",
        "@solana/transactions": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "@ellipsis-labs/rise": {
            "optional": true
        }
    },
    "dependencies": {
        "@msgpack/msgpack": "^3.1.3"
    },
    "devDependencies": {
        "@ellipsis-labs/rise": "^0.4.62",
        "@pipeit/core": "workspace:*",
        "@solana/addresses": "^8.0.0",
        "@solana/instruction-plans": "^8.0.0",
        "@solana/instructions": "^8.0.0",
        "@solana/kit": "^8.0.0",
        "@solana/rpc": "^8.0.0",
        "@solana/rpc-subscriptions": "^8.0.0",
        "@solana/signers": "^8.0.0",
        "@solana/transactions": "^8.0.0",
        "@types/node": "^25.9.4",
        "eslint": "^10.6.0",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    }
}
